rules_version = '2';
// قواعد حماية Aqeq League — انسخيها كاملة في Firebase → Firestore Database → Rules
// حساب المشرفَين مضبوط في دالة isAdmin أدناه
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in ['X7hlzU47gHcft6fDn6QjemcwOlt1', 'fCDuAii4kcXt2V8gGGVpcox2rw42'];
    }

    function player(id) {
      return get(/databases/$(database)/documents/players/$(id)).data;
    }

    function validPlayer(d) {
      return d.keys().hasOnly(['name', 'desc', 'position', 'club', 'price', 'points', 'photo', 'matches', 'fixtures', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.desc is string && d.desc.size() <= 300
        && d.position in ['gk', 'def', 'mid', 'fwd']
        && d.club is string && d.club.size() > 0 && d.club.size() <= 40
        && d.price is number && d.price >= 1 && d.price <= 20
        && d.points is int && d.points >= -999 && d.points <= 99999
        && (!('matches' in d) || (d.matches is list && d.matches.size() <= 80))
        && (!('fixtures' in d) || (d.fixtures is list && d.fixtures.size() <= 40))
        && (d.photo == null || (d.photo is string && d.photo.size() < 700000))
        && d.createdAt is int && d.updatedAt is int;
    }

    // الأساسيون مرتّبون: حارس ثم دفاع ثم وسط ثم هجوم حسب الخطة
    function positionsOk(f, p) {
      return (f == '2-1-1' && p == ['gk', 'def', 'def', 'mid', 'fwd'])
          || (f == '1-2-1' && p == ['gk', 'def', 'mid', 'mid', 'fwd'])
          || (f == '1-1-2' && p == ['gk', 'def', 'mid', 'fwd', 'fwd']);
    }

    function validTeam(d) {
      return d.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.createdAt is int && d.updatedAt is int;
    }

    function validGw(d) {
      return d.keys().hasOnly(['n', 'name', 'stage', 'deadline', 'final', 'pricesApplied'])
        && d.n is int && d.n >= 1 && d.n <= 99
        && d.deadline is int && d.final is bool
        && (!('pricesApplied' in d) || d.pricesApplied is bool)
        && (!('stage' in d) || d.stage in ['gw', 'r16', 'qf', 'sf', 'final'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 40));
    }

    // الجولة مفتوحة للتعديل ما دام الموعد النهائي لم يأتِ
    function gwOpen(gw) {
      return get(/databases/$(database)/documents/gameweeks/$(gw)).data.deadline > request.time.toMillis();
    }

    function validPick(d) {
      let s = d.starters;
      let b = d.bench;
      return d.keys().hasOnly(['formation', 'starters', 'bench', 'captain', 'vice', 'chip', 'updatedAt'])
        && d.formation in ['2-1-1', '1-2-1', '1-1-2']
        && s is list && s.size() == 5 && b is list && b.size() == 1
        && s.concat(b).toSet().size() == 6
        && d.captain in s && d.vice in s && d.captain != d.vice
        && (d.chip == null || d.chip in ['wc', 'fh', 'bb', 'tc'])
        && positionsOk(d.formation, [player(s[0]).position, player(s[1]).position,
             player(s[2]).position, player(s[3]).position, player(s[4]).position])
        && d.updatedAt is int;
    }

    // اللاعبون: الكل يقرأ، والمشرفة فقط تضيف وتعدّل وتحذف
    match /players/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPlayer(request.resource.data);
      allow delete: if isAdmin();
    }

    // فرق الزوار (الاسم فقط): الكل يقرأ، وكل زائر يكتب فريقه فقط، والمشرفة تحذف
    match /teams/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && validTeam(request.resource.data);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // الجولات: الكل يقرأ، والمشرفة فقط تنشئ وتعدّل
    match /gameweeks/{gw} {
      allow read: if true;
      allow create, update: if isAdmin() && validGw(request.resource.data);
      allow delete: if isAdmin();

      // اختيارات الفرق في الجولة: يقفلها الموعد النهائي تلقائيًا
      match /picks/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && gwOpen(gw) && validPick(request.resource.data);
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid && gwOpen(gw));
      }
    }
  }
}
