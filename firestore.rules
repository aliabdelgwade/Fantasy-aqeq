rules_version = '2';
// قواعد حماية Aqeq League — انسخيها كاملة في Firebase → Firestore Database → Rules
// حساب المشرفَين مضبوط في دالة isAdmin أدناه
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in ['X7hlzU47gHcft6fDn6QjemcwOlt1', 'fCDuAii4kcXt2V8gGGVpcox2rw42'];
    }

    function player(id) {
      return get(/databases/$(database)/documents/players/$(id)).data;
    }

    function validPlayer(d) {
      return d.keys().hasOnly(['name', 'desc', 'position', 'club', 'price', 'points', 'photo', 'matches', 'fixtures', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.desc is string && d.desc.size() <= 300
        && d.position in ['gk', 'def', 'mid', 'fwd']
        && d.club is string && d.club.size() > 0 && d.club.size() <= 40
        && d.price is number && d.price >= 1 && d.price <= 20
        && d.points is int && d.points >= -999 && d.points <= 99999
        && (!('matches' in d) || (d.matches is list && d.matches.size() <= 80))
        && (!('fixtures' in d) || (d.fixtures is list && d.fixtures.size() <= 40))
        && (d.photo == null || (d.photo is string && d.photo.size() < 700000))
        && d.createdAt is int && d.updatedAt is int;
    }

    // الأساسيون مرتّبون: حارس ثم دفاع ثم وسط ثم هجوم حسب الخطة
    function positionsOk(f, p) {
      return (f == '2-1-1' && p == ['gk', 'def', 'def', 'mid', 'fwd'])
          || (f == '1-2-1' && p == ['gk', 'def', 'mid', 'mid', 'fwd'])
          || (f == '1-1-2' && p == ['gk', 'def', 'mid', 'fwd', 'fwd']);
    }

    function validTeam(d) {
      return d.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.createdAt is int && d.updatedAt is int;
    }

    function validGw(d) {
      return d.keys().hasOnly(['n', 'name', 'stage', 'off', 'deadline', 'final', 'pricesApplied'])
        && d.n is int && d.n >= 1 && d.n <= 99
        && d.deadline is int && d.final is bool
        && (!('pricesApplied' in d) || d.pricesApplied is bool)
        && (!('stage' in d) || d.stage in ['gw', 'r16', 'qf', 'sf', 'qf1', 'qf2', 'sf1', 'sf2', 'final'])
        && (!('off' in d) || (d.off is list && d.off.size() <= 40))
        && (!('name' in d) || (d.name is string && d.name.size() <= 40));
    }

    // الجولة مفتوحة للتعديل ما دام الموعد النهائي لم يأتِ
    function gwOpen(gw) {
      return get(/databases/$(database)/documents/gameweeks/$(gw)).data.deadline > request.time.toMillis();
    }

    function validPick(d) {
      let s = d.starters;
      let b = d.bench;
      return d.keys().hasOnly(['formation', 'starters', 'bench', 'captain', 'vice', 'chip', 'updatedAt'])
        && d.formation in ['2-1-1', '1-2-1', '1-1-2']
        && s is list && s.size() == 5 && b is list && b.size() == 1
        && s.concat(b).toSet().size() == 6
        && d.captain in s && d.vice in s && d.captain != d.vice
        && (d.chip == null || d.chip in ['wc', 'fh', 'bb', 'tc'])
        && positionsOk(d.formation, [player(s[0]).position, player(s[1]).position,
             player(s[2]).position, player(s[3]).position, player(s[4]).position])
        && d.updatedAt is int;
    }

    // اللاعبون: الكل يقرأ، والمشرفة فقط تضيف وتعدّل وتحذف
    match /players/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPlayer(request.resource.data);
      allow delete: if isAdmin();
    }

    // فرق الزوار (الاسم فقط): الكل يقرأ، وكل زائر يكتب فريقه فقط، والمشرفة تحذف
    match /teams/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && validTeam(request.resource.data);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // شعارات الفرق: الكل يقرأ والمشرفة فقط تكتب
    match /clubs/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['name', 'logo', 'updatedAt'])
                   && request.resource.data.name is string && request.resource.data.name.size() <= 60
                   && request.resource.data.logo is string && request.resource.data.logo.size() < 300000;
    }

    // المباريات: الكل يقرأ والمشرفة فقط تكتب
    match /matches/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
                   && request.resource.data.keys().hasOnly(['a', 'b', 'at', 'sa', 'sb', 'round', 'note', 'lineup', 'events', 'stats', 'ratings', 'bonus', 'updatedAt'])
                   && request.resource.data.a is string && request.resource.data.a.size() <= 60
                   && request.resource.data.b is string && request.resource.data.b.size() <= 60
                   && request.resource.data.at is int;

      // توقعات الجمهور: كل شخص توقع واحد فقط (يقدر يعدّله) قبل بداية المباراة
      match /preds/{uid} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create, update: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(['a', 'b', 'name', 'updatedAt'])
                     && request.resource.data.a is int && request.resource.data.a >= 0 && request.resource.data.a <= 30
                     && request.resource.data.b is int && request.resource.data.b >= 0 && request.resource.data.b <= 30
                     && request.resource.data.name is string && request.resource.data.name.size() <= 60
                     && request.time.toMillis() < get(/databases/$(database)/documents/matches/$(id)).data.at;
      }

      // تصويت أفضل لاعب: صوت واحد لكل حساب (يقدر يغيّره) بعد نهاية المباراة
      match /votes/{uid} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create, update: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(['pid', 'at'])
                     && request.resource.data.pid is string && request.resource.data.pid.size() <= 60
                     && get(/databases/$(database)/documents/matches/$(id)).data.sa is int;
      }

      // التعليقات: أي حساب يعلّق ويرد ويعجب، وصاحب التعليق أو المشرفة يحذفونه
      match /comments/{cid} {
        allow read: if true;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                     && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at', 'parent', 'likes'])
                     && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
                     && request.resource.data.name is string && request.resource.data.name.size() <= 60
                     && request.resource.data.likes == []
                     && (request.resource.data.parent == null || request.resource.data.parent is string);
        allow update: if request.auth != null
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                     && toggledSelf(resource.data.likes, request.resource.data.likes);
      }

      // ألبوم الصور: الكل يشوف، والمشرفة فقط ترفع وتحذف
      match /photos/{pid} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['src', 'at'])
                     && request.resource.data.src is string && request.resource.data.src.size() < 900000;
      }
    }

    // يضيف أو يشيل نفسه فقط من قائمة (للإعجابات وأعضاء الدوري)
    function toggledSelf(oldL, newL) {
      return (newL.hasAll(oldL) && newL.size() == oldL.size() + 1 && newL.hasAny([request.auth.uid]) && !oldL.hasAny([request.auth.uid]))
          || (oldL.hasAll(newL) && newL.size() == oldL.size() - 1 && oldL.hasAny([request.auth.uid]) && !newL.hasAny([request.auth.uid]));
    }

    // الإعلان وشكل الموقع: الكل يقرأ والمشرفة فقط تكتب
    match /site/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // سجل التعديلات: المشرفين فقط يقرون ويضيفون، وما أحد يعدّل أو يحذف
    match /logs/{id} {
      allow read, create: if isAdmin();
    }

    // الدوريات الخاصة: المالك ينشئ ويعدّل الاسم ويشيل أعضاء ويحذف، وأي حساب ينضم أو يغادر بنفسه
    match /leagues/{code} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid
                   && request.resource.data.keys().hasOnly(['name', 'owner', 'ownerName', 'members', 'createdAt'])
                   && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
                   && request.resource.data.members == [request.auth.uid];
      allow delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow update: if request.auth != null && request.resource.data.members.size() <= 300 && (
                     (resource.data.owner == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'members'])
                       && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
                       && request.resource.data.members.hasAny([request.auth.uid]))
                     || (resource.data.owner != request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                       && toggledSelf(resource.data.members, request.resource.data.members)));
    }

    // البطولة (المجموعات والأدوار الإقصائية): الكل يقرأ والمشرفة فقط تكتب
    match /cup/{id} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['groups', 'ko', 'updatedAt'])
                   && request.resource.data.groups is list && request.resource.data.groups.size() <= 16;
    }

    // الجولات: الكل يقرأ، والمشرفة فقط تنشئ وتعدّل
    match /gameweeks/{gw} {
      allow read: if true;
      allow create, update: if isAdmin() && validGw(request.resource.data);
      allow delete: if isAdmin();

      // اختيارات الفرق في الجولة: يقفلها الموعد النهائي تلقائيًا
      match /picks/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && gwOpen(gw) && validPick(request.resource.data);
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid && gwOpen(gw));
      }
    }
  }
}
